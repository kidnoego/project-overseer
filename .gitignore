# ============================================
# Overseer CLI - .gitignore
# Security-hardened for GitHub Alpha
# ============================================

# --- Environment & Secrets ---
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.p12
*.pfx
serviceAccount*.json
*-serviceAccount*.json

# --- Dependencies ---
node_modules/

# --- Build Output ---
dist/
build/
*.tsbuildinfo

# --- Overseer Local State ---
.overseer/
# IDE/runtime cache local (do editor que esta sendo usado pra desenvolver):
.overclock-app/

# --- IDE & Editor ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Runtime / Cache ---
.cache/
tmp/
temp/

# --- OS ---
.DS_Store
desktop.ini

# --- Secrets & Tokens (explicit) ---
**/secret*
**/token*
**/credential*
**/apikey*
**/*-key.json
**/*_key.json